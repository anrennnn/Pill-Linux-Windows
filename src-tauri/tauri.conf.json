{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusPill",
  "version": "0.2.0",
  "identifier": "com.focuspill.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FocusPill",
        "width": 320,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Píldora flotante de productividad",
    "longDescription": "FocusPill es una píldora flotante siempre visible en todos tus escritorios: prioridades del día, Pomodoro ligado a tareas, agenda, captura rápida, notas, informe de foco real e IA local o de tu distro.",
    "publisher": "Anthony",
    "copyright": "© 2026 Anthony",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "focuspill.desktop",
        "recommends": [
          "gnome-shell-extension-appindicator | libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "desktopTemplate": "focuspill.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      },
      "wix": {
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRTYxOUNDRkIyMkQ1NzgKUldSNDFTTDd6Qm5tVzhWTHlJV0FncllmaDBhMGRPazlUSE80VUY3VkJ6RXljcDB4dHAvanJUc3oK",
      "endpoints": [
        "https://github.com/anrennnn/pill-linux-windows/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
